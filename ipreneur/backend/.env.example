# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=iPreneur
APP_ENV=development  # development | staging | production
APP_SECRET_KEY=change_me_in_production_use_secrets_manager
APP_DEBUG=true
APP_PORT=8000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ipreneur:ipreneur_dev@localhost:5432/ipreneur
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:redis_dev@localhost:6379/0
REDIS_CACHE_TTL=3600

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
# Key 1: Company/website deep analysis (BrandingExtractor, AnalysisAgent, ContentGenerationAgent)
GEMINI_API_KEY=your_gemini_api_key_1_here
# Key 2: Industry & market research (ResearchAgent) — can be same key or a second project key
GEMINI_API_KEY_2=your_gemini_api_key_2_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=8192
GEMINI_THINKING_BUDGET=8192

# ─── Anthropic AI (optional fallback) ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096

# ─── File Storage (S3 / MinIO) ────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=ipreneur
S3_REGION=us-east-1
CDN_BASE_URL=http://localhost:9000/ipreneur

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_dev@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_dev@localhost:6379/2

# ─── Monitoring ───────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=DEBUG

# ─── Billing (Stripe) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_PRO_PRICE_ID=price_xxxxxxxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxxxxxxx

# ─── Playwright ───────────────────────────────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
CRAWL_TIMEOUT_MS=30000
CRAWL_MAX_PAGES=15
